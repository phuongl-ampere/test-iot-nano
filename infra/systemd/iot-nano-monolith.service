[Unit]
Description=Rush IoT Nano monolith
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iotnano
Group=iotnano
UMask=0077
StateDirectory=iot-nano
EnvironmentFile=/etc/iot-nano/monolith.env
ExecStart=/opt/rush-iot-nano/iot-nano-monolith
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/iot-nano

[Install]
WantedBy=multi-user.target
