[Unit]
Description=Rush IoT Nano monolith
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iotnano
Group=iotnano
UMask=0077
StateDirectory=iot-nano
EnvironmentFile=/etc/iot-nano/monolith.env
ExecStart=/opt/rush-iot-nano/iot-nano-monolith
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
StateDirectoryMode=0700
ReadWritePaths=/var/lib/iot-nano
# The default ports are unprivileged, so this unit grants no bind capability.
# If a deployment deliberately selects a public HTTP or MQTT port below 1024,
# replace the two empty capability assignments above with:
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# Keep IOT_NANO_MANAGEMENT_ADDRESS on a protected, non-public address.

[Install]
WantedBy=multi-user.target
