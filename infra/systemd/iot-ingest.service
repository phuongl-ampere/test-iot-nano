[Unit]
Description=Rush IoT Nano durable MQTT stream ingest service
After=network-online.target nanomq.service
Wants=network-online.target

[Service]
Type=simple
User=iot
Group=iot
UMask=0077
EnvironmentFile=/etc/rush-iot-nano/ingest.env
ExecStart=/opt/rush-iot-nano/iot-ingest
Restart=always
RestartSec=3
WorkingDirectory=/var/lib/iot-ingest
StateDirectory=iot-ingest
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
