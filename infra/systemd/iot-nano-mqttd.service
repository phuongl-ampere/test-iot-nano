[Unit]
Description=Rush IoT Rust MQTT broker acceptance runtime
After=network-online.target iot-nano-api.service iot-nano-stream.service
Wants=network-online.target iot-nano-api.service iot-nano-stream.service

[Service]
Type=simple
User=iot
Group=iot
UMask=0077
EnvironmentFile=/etc/rush-iot-nano/iot-nano-mqttd.env
ExecStart=/opt/rush-iot-nano/iot-nano-mqttd
Restart=always
RestartSec=3
LimitNOFILE=65536
WorkingDirectory=/opt/rush-iot-nano

[Install]
WantedBy=multi-user.target
