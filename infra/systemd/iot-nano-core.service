[Unit]
Description=Rush IoT Nano data-plane core service
After=network-online.target iot-nano-stream.service
Wants=network-online.target iot-nano-stream.service

[Service]
Type=simple
User=iot
Group=iot
UMask=0077
EnvironmentFile=/etc/rush-iot-nano/iot-nano-core.env
ExecStart=/opt/rush-iot-nano/iot-nano-core
Restart=always
RestartSec=3
WorkingDirectory=/var/lib/iot-nano-core
StateDirectory=iot-nano-core
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
