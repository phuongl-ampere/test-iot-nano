# Copy to /etc/iot-nano/monolith.env, make it owner-readable, and replace all
# placeholder values. Do not commit a populated copy or put secrets in logs.
IOT_NANO_STORAGE=sqlite
IOT_NANO_SQLITE_PATH=/var/lib/iot-nano/platform/platform.sqlite
IOT_NANO_INTERNAL_DIR=/var/lib/iot-nano/internal
# The certificate and private key must be readable by the iotnano service user.
IOT_NANO_TLS_CERT_PATH=/run/tls/mqtt-cert.pem
IOT_NANO_TLS_KEY_PATH=/run/tls/mqtt-key.pem
IOT_NANO_HTTP_ADDRESS=0.0.0.0:8080
IOT_NANO_MQTT_TCP_ADDRESS=0.0.0.0:1883
IOT_NANO_MQTT_TLS_ADDRESS=0.0.0.0:8883
# Use a randomly generated ASCII key of at least 32 non-whitespace characters.
IOT_DEVICE_TOKEN_VAULT_KEY=replace-with-at-least-32-ascii-non-whitespace-characters
# Optional tuning. The defaults are normally appropriate.
# IOT_NANO_SQLITE_BUSY_TIMEOUT_MS=5000
# IOT_NANO_SHUTDOWN_DEADLINE_SECONDS=30
# For TimescaleDB, select the timescale storage mode.
# Set DATABASE_URL instead of the SQLite path.
# Never set DATABASE_URL together with IOT_NANO_SQLITE_PATH.
# Offline Timescale rollback also requires one-shot operator inputs. Do not
# persist restore commands or restore-point paths in this service environment.
# TIMESCALE_RESTORE_COMMAND=/usr/local/libexec/iot-nano/restore-timescale
# TIMESCALE_RESTORE_ROOT=/var/backups/iot-nano/timescale-restore-points
# TIMESCALE_CURRENT_RESTORE_POINT=/var/backups/iot-nano/timescale-restore-points/current
# TIMESCALE_COMPENSATE_COMMAND=/usr/local/libexec/iot-nano/restore-timescale
# Set these only for one `--bootstrap-system` invocation, then remove them.
# IOT_NANO_BOOTSTRAP_SYSTEM_USERNAME=initial-system
# IOT_NANO_BOOTSTRAP_SYSTEM_PASSWORD=replace-with-a-strong-password
