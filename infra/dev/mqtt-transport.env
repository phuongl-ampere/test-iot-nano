# Bind only on loopback for development. Production must use 0.0.0.0:8883.
IOT_MQTT_TRANSPORT_ADDRESS=127.0.0.1:8883
IOT_MQTT_TRANSPORT_INTERNAL_ADDRESS=127.0.0.1:8083
IOT_MQTT_TRANSPORT_TLS_CERT_PATH=/tmp/rush-iot-nano/tls/mqtt-cert.pem
IOT_MQTT_TRANSPORT_TLS_KEY_PATH=/tmp/rush-iot-nano/tls/mqtt-key.pem
IOT_MQTT_TRANSPORT_API_BASE_URL=http://127.0.0.1:8080
IOT_MQTT_TRANSPORT_SECRET=development-mqtt-transport-secret-32-bytes
IOT_MQTT_TRANSPORT_INGEST_WEBHOOK_URL=http://127.0.0.1:18081/internal/mqtt-transport/telemetry
IOT_MQTT_TRANSPORT_INGEST_WEBHOOK_SECRET=development-mqtt-transport-ingest-webhook-secret-32-bytes
