PLATFORM_BASE_URL=https://platform.example.test
PLATFORM_AUTH_BASE_URL=https://platform.example.test
OAUTH_CLIENT_ID=powermonitor-client
OAUTH_CLIENT_SECRET=replace-with-server-secret
OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/callback
OAUTH_SCOPE=devices:read assets:read telemetry:read alerts:read alerts:write commands:read commands:write
OAUTH_SERVICE_CLIENT_ID=powermonitor-service
OAUTH_SERVICE_CLIENT_SECRET=replace-with-server-service-secret
OAUTH_SERVICE_SCOPE=telemetry:aggregate
SESSION_SECRET=replace-with-at-least-32-random-bytes
