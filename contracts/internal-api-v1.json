{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iot-nano/internal-api-v1",
  "title": "InternalServiceAuthenticationV1",
  "services": {
    "mqttd_to_api": {
      "header": "x-iot-nano-mqttd-api-secret",
      "endpoints": [
        "/internal/mqttd/session-resolution",
        "/internal/mqttd/gateway-authorization",
        "/internal/mqttd/rpc-response",
        "/internal/mqttd/sessions/revoke"
      ]
    },
    "mqttd_to_stream": {
      "header": "x-iot-nano-mqttd-stream-secret",
      "endpoints": [
        "/internal/streams/telemetry/append",
        "/internal/streams/gateway/append"
      ]
    },
    "core_to_stream": {
      "header": "x-iot-nano-core-stream-secret",
      "endpoints": [
        "/internal/groups/{group}/claim",
        "/internal/groups/{group}/ack"
      ]
    },
    "api_to_core": {
      "header": "x-iot-nano-api-core-secret",
      "endpoints": [
        "/internal/commands",
        "/internal/commands/{id}",
        "/internal/commands/response",
        "/internal/telemetry/devices/{device_id}",
        "/internal/rollups/devices/{device_id}",
        "/internal/alerts",
        "/internal/notifications"
      ]
    }
  }
}
